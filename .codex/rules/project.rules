# Read-only inspection commands are safe to run outside the sandbox.
prefix_rule(
    pattern = ["rg"],
    decision = "allow",
    justification = "Repository text search is read-only",
    match = ["rg -n Payment document", "rg --files source"],
)

prefix_rule(
    pattern = ["git", ["status", "diff", "log", "show"]],
    decision = "allow",
    justification = "These Git commands inspect repository state without modifying it",
    match = ["git status --short", "git diff --check", "git log -5 --oneline"],
    not_match = ["git add .", "git commit -m change"],
)

prefix_rule(
    pattern = ["docker", "compose", "config"],
    decision = "allow",
    justification = "Compose configuration validation is non-mutating",
    match = ["docker compose config", "docker compose config --quiet"],
)

# Docker lifecycle operations can download images or mutate containers, networks, and volumes.
prefix_rule(
    pattern = ["docker", "compose", ["build", "up", "down", "pull", "push"]],
    decision = "prompt",
    justification = "Confirm Docker operations that change local or remote state",
    match = ["docker compose build", "docker compose up -d", "docker compose down"],
)

# Deployment and destructive cleanup always require a deliberate path outside Codex auto-approval.
prefix_rule(
    pattern = ["kubectl", ["apply", "delete", "replace", "patch", "scale", "rollout"]],
    decision = "prompt",
    justification = "Cluster mutations require explicit approval",
    match = ["kubectl apply -f deploy.yaml", "kubectl rollout restart deployment/order-service"],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Use a targeted, recoverable edit instead of discarding repository changes",
    match = ["git reset --hard", "git reset --hard HEAD~1"],
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "forbidden",
    justification = "Inspect untracked files and remove only explicit targets after user approval",
    match = ["git clean -fd", "git clean -xdf"],
)

prefix_rule(
    pattern = ["docker", "system", "prune"],
    decision = "forbidden",
    justification = "Remove only explicitly inspected Docker resources instead of system-wide pruning",
    match = ["docker system prune", "docker system prune -af"],
)

prefix_rule(
    pattern = ["docker", "volume", ["rm", "prune"]],
    decision = "forbidden",
    justification = "Database volumes may contain unrecoverable project data",
    match = ["docker volume rm coffee-postgres", "docker volume prune"],
)

